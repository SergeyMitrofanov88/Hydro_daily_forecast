# Исключаемые файлы и директории (не проверяются линтером)
exclude =
    __init__.py,      # часто содержит только импорты/реэкспорты
    venv,             # виртуальное окружение
    alembic,          # автогенерируемые миграции БД
    docker,           # файлы/скрипты Docker
    .git,             # служебная директория Git
    __pycache__       # скомпилированные байткоды Python

# Максимальная длина строки (в символах)
max-line-length = 120

# Игнорируемые правила:
# E203 — пробел перед ':' (конфликтует с black)
# E266 — слишком много '#' перед комментарием (блок-комментарии)
# E501 — длина строки (дублирует max-line-length, но страхует)
# W503 — перенос строки перед бинарным оператором (конфликтует с black)
ignore = E203, E266, E501, W503
